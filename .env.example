# --- Adatbázis ---
# Helyi fejlesztéshez a kettő megegyezik. Supabase/PgBouncer esetén a
# DATABASE_URL a pooled (6543-as port, ?pgbouncer=true) kapcsolat, a
# DIRECT_URL pedig a közvetlen (5432-es port) kapcsolat — ez utóbbit
# használja a `prisma migrate`.
DATABASE_URL="postgresql://szucssanyi:szucssanyi_dev@localhost:5432/szucssanyi_dev?schema=public"
DIRECT_URL="postgresql://szucssanyi:szucssanyi_dev@localhost:5432/szucssanyi_dev?schema=public"

# --- Auth.js (admin / szakember bejelentkezés) ---
# Generáld: openssl rand -base64 32
AUTH_SECRET="TODO-generate-a-random-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seedeléskor létrehozott admin belépési adatok (fejlesztéshez).
ADMIN_EMAIL="sandor@szucssanyi.hu"
ADMIN_PASSWORD="ChangeMe123!"

# --- Stripe (fizetés) ---
# TODO élesítés előtt pótlandó: Stripe teszt/éles kulcsok.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="TODO-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="TODO-stripe-publishable-key"
# Webhook secret a `stripe listen --forward-to localhost:3000/api/webhooks/stripe` parancsból,
# élesben a Stripe Dashboard webhook endpoint beállításából.
STRIPE_WEBHOOK_SECRET="TODO-stripe-webhook-secret"

# --- Tranzakciós e-mail (SMTP) ---
# TODO pótlandó: saját SMTP fiók (pl. tárhelyszolgáltató, Postmark, Resend SMTP, stb.)
SMTP_HOST="TODO-smtp-host"
SMTP_PORT="587"
SMTP_USER="TODO-smtp-user"
SMTP_PASSWORD="TODO-smtp-password"
SMTP_FROM="Szűcs Sándor <no-reply@szucssanyi.hu>"

# --- Cron endpoint védelem (foglalás-hold felszabadítás, emlékeztetők) ---
# Külső ütemező (pl. Vercel Cron vagy cron-job.org) ezzel a titokkal hívja az
# /api/cron/* route-okat: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="TODO-generate-a-random-secret"

# --- MailerLite (opcionális, később köthető be a kapcsolat/feliratkozás formokhoz) ---
MAILERLITE_API_KEY=""

# --- Analitika (opcionális placeholder) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Social linkek (lábléc) ---
